{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Editions": {
    "Default": "v2",
    "Items": [
      { "Id": "v1", "Name": "V1", "Tag": "Initial" },
      { "Id": "v2", "Name": "V2", "Tag": "Production" }
    ]
  },
  "Games": {
    "ShowLibrary": false
  },
  "GameStore": {
    "Provider": "Json",
    "SeedPath": "Content/games.seed.json",
    "DatabaseName": "tauweb",
    "ContainerName": "games",
    "SeedOnStartup": true
  },
  "AllowedHosts": "*"
}
